#include "resource.h"

/* Значок приложения - будет виден в Проводнике, на панели задач,
 * в Alt-Tab и т.д. IDI_APPICON с наименьшим числовым значением среди
 * ICON-ресурсов автоматически становится "главным" значком .exe для
 * Проводника Windows (стандартное поведение). */
IDI_APPICON ICON "acars.ico"
